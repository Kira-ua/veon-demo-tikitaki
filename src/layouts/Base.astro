---
import "@fontsource/fira-sans-extra-condensed/600.css";
import "@fontsource/fira-sans-extra-condensed/700.css";
import "@fontsource-variable/golos-text/wght.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import "../styles/sections.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1E1E1C" />
    <meta property="og:locale" content="uk_UA" />
    <slot name="head" />
    <style is:global>
      html { overflow-x: clip; }
      body { overflow-x: clip; }
    </style>
  </head>
  <body id="top" data-rec="R-015,G-R004">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
