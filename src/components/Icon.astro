---
// Inline SVG icons (currentColor). Decorative: the parent link/button carries the accessible name.
type Name = "phone" | "telegram" | "mail" | "menu" | "close" | "instagram" | "tiktok" | "facebook" | "youtube";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5C10.6 20 4 13.4 3.5 5.1A1.5 1.5 0 0 1 5 3.5Z" />}
  {name === "telegram" && <path d="M21 4 3 11.2l6.2 2.2M21 4l-3 16-8.8-6.6M21 4 9.2 13.4m0 0v5.6l3.2-3.2" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></>}
  {name === "tiktok" && <path d="M14 3.5v11.2a3.7 3.7 0 1 1-3.7-3.7M14 3.5c.4 2.6 2.3 4.4 5 4.6" />}
  {name === "facebook" && <path d="M14.5 21v-7.5h2.8l.5-3.3h-3.3V8.3c0-1 .4-1.8 1.9-1.8H18V3.7a19 19 0 0 0-2.6-.2c-2.7 0-4.4 1.6-4.4 4.6v2.1H8v3.3h3V21" />}
  {name === "youtube" && <><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="m10 9.2 5 2.8-5 2.8Z" fill="currentColor" /></>}
</svg>
